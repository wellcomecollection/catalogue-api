# Template for .env.rds.local — copy and fill in, then run ./run-local-rds.sh
#
#   cp .env.rds.local.example .env.rds.local
#
# Runs the Identifiers API against the real Aurora ID Registry via the RDS Data
# API. READ-ONLY: only SELECTs are issued. NEVER write or seed this database.

AWS_PROFILE=platform-developer
AWS_REGION=eu-west-1

IDENTIFIERS_BACKEND=rds

# The Aurora cluster ARN (dev test cluster):
RDS_RESOURCE_ARN=arn:aws:rds:eu-west-1:760097843905:cluster:identifiers-v2-serverless-test

# The Secrets Manager ARN with the DB credentials. This is the cluster's managed
# master-user secret; find it with:
#   AWS_PROFILE=platform-developer aws rds describe-db-clusters \
#     --db-cluster-identifier identifiers-v2-serverless-test \
#     --query 'DBClusters[0].MasterUserSecret.SecretArn' --output text
RDS_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:760097843905:secret:rds!cluster-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX-XXXXXX

RDS_DATABASE=identifiers
